{
    "name": "cors/web-care",
    "type": "pimcore-bundle",
    "description": "CORS - WebCare Integration",
    "keywords": [
        "cors",
        "pimcore",
        "datareporter",
        "webcare",
        "cookiebanner"
    ],
    "homepage": "http://www.cors.gmbh",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "CORS GmbH",
            "email": "office@cors.gmbh",
            "homepage": "https://www.cors.gmbh/",
            "role": "TEAM"
        }
    ],
    "require": {
        "php": ">=8.1",
        "pimcore/admin-ui-classic-bundle": "^2.0",
        "pimcore/pimcore": "^12.0",
        "doctrine/orm": "^3.0",
        "symfony/dotenv": "^6.4 || ^7.0",
        "symfony/form": "^6.4 || ^7.0"
    },
    "require-dev": {
        "symplify/easy-coding-standard": "^9.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "vimeo/psalm": "^6.0",
        "symfony/runtime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "CORS\\Bundle\\WebCareBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-12": "12.0-dev"
        },
        "pimcore": {
            "bundles": [
                "CORS\\Bundle\\WebCareBundle\\CORSWebCareBundle"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "conflict": {
        "pimcore/studio-ui-bundle": "<2025.4.12"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}

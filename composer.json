{
    "name": "cors/web-care",
    "type": "pimcore-bundle",
    "description": "CORS - WebCare Integration",
    "keywords": [
        "cors",
        "pimcore",
        "datareporter",
        "webcare",
        "cookiebanner"
    ],
    "homepage": "http://www.cors.gmbh",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "CORS GmbH",
            "email": "office@cors.gmbh",
            "homepage": "https://www.cors.gmbh/",
            "role": "TEAM"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "pimcore/pimcore": "^2026.2",
        "pimcore/studio-backend-bundle": "^2026.1",
        "pimcore/studio-ui-bundle": "^2026.2",
        "doctrine/orm": "^3.0"
    },
    "require-dev": {
        "cors/dev": "^2026.1",
        "phpunit/phpunit": "^11.0",
        "symfony/runtime": "^8.1",
        "symfony/dotenv": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "CORS\\Bundle\\WebCareBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "Kernel.php"
        ],
        "psr-4": {
            "App\\": "dev",
            "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2026.x": "2026.1.x-dev"
        },
        "pimcore": {
            "bundles": [
                "CORS\\Bundle\\WebCareBundle\\CORSWebCareBundle"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}

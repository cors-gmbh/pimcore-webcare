/vendor/
/node_modules/
/.phpunit.cache/
/.rsbuild/
/dist/
.DS_Store
.idea/
.php-cs-fixer.cache
# dev environment only, the bundle itself must not pin its PHP dependencies
/composer.lock

# Expanded Studio build. Not committed: the build ships as an archive in
# src/Resources/build-dist/build-<id>.zip, which Pimcore's BuildArchiveExtractor unpacks into
# src/Resources/public/studio at cache warmup. The extractor's marker, lock and temporary
# directories live next to it; @mf-types are generated by module federation.
/src/Resources/public/studio/*
/src/Resources/public/.studio*
/src/Resources/assets/pimcore-studio/@mf-types/

# --- dev harness ---
# var is generated, but PHPStan (Pimcore extension) needs var/classes/DataObject in CI
/var/*
!/var/classes
/var/classes/*
!/var/classes/DataObject
/var/classes/DataObject/*
!/var/classes/DataObject/.gitkeep
# the anchored var rule above does not cover the web root
/public/var
/public/bundles
.env.local
# config.yaml imports local/*.yaml; the kernel fails without the directory in CI
/config/local/*
!/config/local/.gitkeep
/config/reference.php
supervisord.pid

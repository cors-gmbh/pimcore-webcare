{
  "name": "@cors/web-care-studio",
  "version": "1.0.0",
  "description": "CORS WebCare - Pimcore Studio Plugin",
  "main": "src/Resources/assets/pimcore-studio/src/index.ts",
  "exports": {
    ".": "./src/Resources/assets/pimcore-studio/src/index.ts"
  },
  "scripts": {
    "build": "rsbuild build && studio-package-build --build-dir src/Resources/public/studio --out-dir src/Resources/build-dist",
    "dev": "rsbuild dev",
    "check-types": "tsc --noEmit",
    "check-types-watch": "tsc --noEmit --watch",
    "clean": "rm -rf node_modules/.cache dist"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^0.13.1",
    "@rsbuild/core": "^1.3.16",
    "@rsbuild/plugin-react": "^1.3.1",
    "@rsbuild/plugin-svgr": "^1.2.2",
    "@types/node": "^22.14.0",
    "@types/react-dom": "18.3.x",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@pimcore/studio-ui-bundle": "2025.4.14",
    "@reduxjs/toolkit": "^2.0.1",
    "@tanstack/react-table": "^8.20.5",
    "antd": "^5.12.0",
    "react": "18.3.x",
    "react-dom": "18.3.x",
    "react-i18next": "^15.0.0",
    "react-redux": "^9.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "web-care",
    "pimcore",
    "studio",
    "plugins",
    "react",
    "typescript"
  ]
}

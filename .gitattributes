# Files that are not part of the distributed composer package (cors/web-care).
# The bundle itself is src/ (CORSWebCareBundle::getPath(), Resources/ included) plus
# composer.json, README.md and the license files; everything below only serves the dev
# harness (Kernel.php, config/, dev/, docker-compose.yaml), the Studio frontend build or the CI.
/dev                                    export-ignore
/tests                                  export-ignore
/bin                                    export-ignore
/config                                 export-ignore
/public                                 export-ignore
/templates                              export-ignore
/var                                    export-ignore
/Kernel.php                             export-ignore
/docker-compose.yaml                    export-ignore
/.env                                   export-ignore
/.env.local                             export-ignore
/.gitattributes                         export-ignore
/.gitignore                             export-ignore
/.gitlab-ci.yml                         export-ignore
/.github                                export-ignore
/ecs.php                                export-ignore
/phpstan.neon                           export-ignore
/psalm.xml                              export-ignore
/phpunit.dist.xml                       export-ignore
/package.json                           export-ignore
/package-lock.json                      export-ignore
/rsbuild.config.ts                      export-ignore
/tsconfig.json                          export-ignore
/ISSUE_TEMPLATE.md                      export-ignore
/PULL_REQUEST_TEMPLATE.md               export-ignore
